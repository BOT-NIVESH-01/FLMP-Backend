MONGO_URI=mongodb://127.0.0.1:27017/leave_management
JWT_SECRET=your_secret_key

# SMTP configuration (required for notifications)
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email-or-smtp-user
SMTP_PASS=your-smtp-password-or-app-password
EMAIL_FROM=your-email-or-sender@domain.com

# Daily timetable scheduler
# Default: 6:00 AM every day
DAILY_TIMETABLE_CRON=0 6 * * *
DAILY_TIMETABLE_TIMEZONE=Asia/Kolkata
